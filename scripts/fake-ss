#!/usr/bin/env python3
"""Plays iproute2's `ss -ltnpH` for tests: prints the lines in the file $FAKE_SS_LINES names, leaving out processes
that have exited, as a socket goes with its last process, and fails when that file is missing, as `ss` can on a host.
Without $FAKE_SS_LINES it prints this Mac's listening sockets of this user, read with `netstat`, as `ss` prints a
host's without root; tests ask for ports again and again, and `lsof` takes a second or more on a Mac. A file
.fake-ss-home-only in $HOME, the fake host's home, keeps only the processes working in that home, so the rest of this
Mac's servers stay off the host, as they would on another machine. $FAKE_SS_SLEEP makes it take that many seconds
first, and a file .fake-ss-fails in $HOME makes it fail, noting each failure in .fake-ss-failed there, as `ss` on a
busy host can."""
import os
import re
import subprocess
import sys
import time

USER = re.compile(r'\("[^"]*",pid=(\d+),fd=\d+\)')


def running(pid):
    state = subprocess.run(["ps", "-o", "stat=", "-p", pid], capture_output=True, encoding="utf-8").stdout.strip()
    return state != "" and not state.startswith("Z")


def live(line):
    """The line with only the processes that still run, or None when none of its processes do."""
    users = USER.findall(line)
    if not users:
        return line
    kept = [match.group(0) for match in USER.finditer(line) if running(match.group(1))]
    if not kept:
        return None
    return line[:line.index("users:((")] + "users:(" + ",".join(kept) + ")"


def working_in(folder, pids):
    """The pids whose working folder is in `folder`, read with libproc."""
    import ctypes
    proc_pidinfo = ctypes.CDLL("/usr/lib/libSystem.B.dylib").proc_pidinfo
    proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
    proc_pidinfo.restype = ctypes.c_int
    # PROC_PIDVNODEPATHINFO: the working folder's vnode_info, 152 bytes, and its path, then the same for the root.
    info, path = 152, 1024
    size = 2 * (info + path)
    buffer = ctypes.create_string_buffer(size)
    inside = set()
    for pid in pids:
        if proc_pidinfo(int(pid), 9, 0, buffer, size) != size:
            continue
        cwd = os.path.realpath(os.fsdecode(buffer.raw[info:info + path].split(b"\0", 1)[0]))
        if cwd == folder or cwd.startswith(folder + os.sep):
            inside.add(pid)
    return inside


def users():
    """Each process's user id, by pid."""
    listed = subprocess.run(["/bin/ps", "-A", "-o", "pid=,uid="], capture_output=True, encoding="utf-8").stdout
    return {fields[0]: fields[1] for fields in (line.split() for line in listed.splitlines()) if len(fields) == 2}


def address(protocol, local):
    """`ss`'s host and port for one of `netstat`'s local addresses, such as `127.0.0.1.5173` or `*.5173`."""
    host, _, port = local.rpartition(".")
    if host == "*":
        host = "0.0.0.0" if protocol == "tcp4" else "[::]"
    elif protocol != "tcp4":
        host = "[%s]" % host
    return host, port


def from_netstat():
    """This user's listening TCP sockets, one line for each address and port with every process holding it."""
    listed = subprocess.run(["/usr/sbin/netstat", "-anv", "-p", "tcp"], stdin=subprocess.DEVNULL,
                            capture_output=True, encoding="utf-8", errors="replace")
    if listed.returncode != 0:
        print(listed.stderr, end="", file=sys.stderr)
        return None
    lines = listed.stdout.splitlines()
    header = next((line.split() for line in lines if "process:pid" in line), None)
    if header is None:
        print("fake-ss: netstat printed no process:pid column", file=sys.stderr)
        return None
    # A process's name can hold spaces, so it is what lies between the ten columns before it and those after.
    after = len(header) - header.index("process:pid") - 1
    uid = str(os.getuid())
    owners = users()
    sockets = {}
    for line in lines:
        fields = line.split()
        if len(fields) <= 10 + after or not fields[0].startswith("tcp") or fields[5] != "LISTEN":
            continue
        name, _, pid = " ".join(fields[10:len(fields) - after]).rpartition(":")
        if not pid.isdigit() or owners.get(pid) != uid:
            continue
        holders = sockets.setdefault(address(fields[0], fields[3]), [])
        if all(holder[1] != pid for holder in holders):
            holders.append((name, pid, "0"))
    home = os.path.realpath(os.environ.get("HOME", "/"))
    if os.path.exists(os.path.join(home, ".fake-ss-home-only")):
        inside = working_in(home, {pid for holders in sockets.values() for _, pid, _ in holders})
        sockets = {key: [holder for holder in holders if holder[1] in inside] for key, holders in sockets.items()}
    peer = {True: "[::]:*", False: "0.0.0.0:*"}
    return ["LISTEN 0 128 %s:%s %s users:(%s)" % (
        host, port, peer[host.startswith("[")], ",".join('("%s",pid=%s,fd=%s)' % holder for holder in holders))
        for (host, port), holders in sockets.items() if holders]


def main(arguments):
    if arguments != ["-ltnpH"]:
        print("fake-ss: only -ltnpH", file=sys.stderr)
        return 1
    time.sleep(float(os.environ.get("FAKE_SS_SLEEP", "0")))
    home = os.environ.get("HOME", "/")
    if os.path.exists(os.path.join(home, ".fake-ss-fails")):
        with open(os.path.join(home, ".fake-ss-failed"), "a", encoding="ascii") as failures:
            failures.write("failed\n")
        print("Cannot open netlink socket: Device or resource busy", file=sys.stderr)
        return 1
    if "FAKE_SS_LINES" not in os.environ:
        lines = from_netstat()
        if lines is None:
            return 1
        for line in lines:
            print(line)
        return 0
    try:
        with open(os.environ["FAKE_SS_LINES"], encoding="utf-8") as file:
            lines = file.read().splitlines()
    except OSError:
        print("Cannot open netlink socket: Protocol not supported", file=sys.stderr)
        return 1
    for line in lines:
        shown = live(line)
        if shown is not None:
            print(shown)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

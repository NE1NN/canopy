#!/usr/bin/env python3
"""Plays iproute2's `ss -ltnpH` for tests: prints the lines in the file $FAKE_SS_LINES names, leaving out processes
that have exited, as a socket goes with its last process, and fails when that file is missing, as `ss` can on a host.
Without $FAKE_SS_LINES it prints this Mac's listening sockets of this user, read with `lsof`, as `ss` prints a host's
without root. A file .fake-ss-home-only in $HOME, the fake host's home, keeps only the processes working in that home,
so the rest of this Mac's servers stay off the host, as they would on another machine. $FAKE_SS_SLEEP makes it take that
many seconds first, and a file .fake-ss-fails in $HOME makes it fail, noting each failure in .fake-ss-failed there, as
`ss` on a busy host can."""
import os
import re
import subprocess
import sys
import time

USER = re.compile(r'\("[^"]*",pid=(\d+),fd=\d+\)')


def running(pid):
    state = subprocess.run(["ps", "-o", "stat=", "-p", pid], capture_output=True, encoding="utf-8").stdout.strip()
    return state != "" and not state.startswith("Z")


def live(line):
    """The line with only the processes that still run, or None when none of its processes do."""
    users = USER.findall(line)
    if not users:
        return line
    kept = [match.group(0) for match in USER.finditer(line) if running(match.group(1))]
    if not kept:
        return None
    return line[:line.index("users:((")] + "users:(" + ",".join(kept) + ")"


def working_in(folder, pids):
    """The pids whose working folder is in `folder`."""
    if not pids:
        return set()
    listed = subprocess.run(
        ["/usr/sbin/lsof", "-w", "-a", "-p", ",".join(sorted(pids)), "-d", "cwd", "-Fn"],
        stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
    inside = set()
    pid = None
    for line in listed.stdout.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n") and pid is not None:
            cwd = os.path.realpath(line[1:])
            if cwd == folder or cwd.startswith(folder + os.sep):
                inside.add(pid)
    return inside


def from_lsof():
    """This user's listening TCP sockets, one line for each address and port with every process holding it."""
    # The host's PATH, as a test sets it, can leave out /usr/sbin.
    listed = subprocess.run(
        ["/usr/sbin/lsof", "-w", "-nP", "-a", "-u", str(os.getuid()), "-iTCP", "-sTCP:LISTEN", "-F", "pcftn"],
        stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
    # lsof exits 1 when nothing listens, which ss reports as no lines.
    if listed.returncode not in (0, 1):
        print(listed.stderr, end="", file=sys.stderr)
        return None
    sockets = {}
    pid = name = descriptor = family = None
    for line in listed.stdout.splitlines():
        tag, value = line[:1], line[1:]
        if tag == "p":
            pid = value
        elif tag == "c":
            name = value
        elif tag == "f":
            descriptor = value
        elif tag == "t":
            family = value
        elif tag == "n" and pid is not None and ":" in value:
            host, _, port = value.rpartition(":")
            if host == "*":
                host = "0.0.0.0" if family == "IPv4" else "[::]"
            sockets.setdefault((host, port), []).append((name, pid, descriptor))
    home = os.path.realpath(os.environ.get("HOME", "/"))
    if os.path.exists(os.path.join(home, ".fake-ss-home-only")):
        inside = working_in(home, {pid for holders in sockets.values() for _, pid, _ in holders})
        sockets = {key: [holder for holder in holders if holder[1] in inside] for key, holders in sockets.items()}
    peer = {True: "[::]:*", False: "0.0.0.0:*"}
    return ["LISTEN 0 128 %s:%s %s users:(%s)" % (
        host, port, peer[host.startswith("[")], ",".join('("%s",pid=%s,fd=%s)' % holder for holder in holders))
        for (host, port), holders in sockets.items() if holders]


def main(arguments):
    if arguments != ["-ltnpH"]:
        print("fake-ss: only -ltnpH", file=sys.stderr)
        return 1
    time.sleep(float(os.environ.get("FAKE_SS_SLEEP", "0")))
    home = os.environ.get("HOME", "/")
    if os.path.exists(os.path.join(home, ".fake-ss-fails")):
        with open(os.path.join(home, ".fake-ss-failed"), "a", encoding="ascii") as failures:
            failures.write("failed\n")
        print("Cannot open netlink socket: Device or resource busy", file=sys.stderr)
        return 1
    if "FAKE_SS_LINES" not in os.environ:
        lines = from_lsof()
        if lines is None:
            return 1
        for line in lines:
            print(line)
        return 0
    try:
        with open(os.environ["FAKE_SS_LINES"], encoding="utf-8") as file:
            lines = file.read().splitlines()
    except OSError:
        print("Cannot open netlink socket: Protocol not supported", file=sys.stderr)
        return 1
    for line in lines:
        shown = live(line)
        if shown is not None:
            print(shown)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
